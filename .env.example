# --- Claude -------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5
CLAUDE_MAX_TOKENS=16000
# Server-side fallback when the primary model declines a request
ENABLE_REFUSAL_FALLBACK=true

# --- Workflow limits ----------------------------------------------------
MAX_STEPS=15
EXECUTOR_MAX_RETRIES=1
MAX_CORRECTION_ROUNDS=2
MAX_OUTPUT_ATTEMPTS=3
MAX_PLAN_REQUESTS=3

# --- Supervisor safety gate ---------------------------------------------
# never | high_risk | always  (when a human must approve a plan before it runs)
APPROVAL_MODE=high_risk
# Domains treated as internal; other email/invite recipients are flagged as external
INTERNAL_DOMAINS=["ourco.com"]
BULK_RECIPIENT_THRESHOLD=5
BULK_MESSAGE_THRESHOLD=10

# --- Memory (ChromaDB) --------------------------------------------------
# default = Chroma's ONNX MiniLM (downloads ~80MB on first use); hash = offline
EMBEDDING_BACKEND=default
MEMORY_TOP_K=3
# Past workflows farther than this cosine distance are not shown to the planner
MEMORY_MAX_DISTANCE=0.6

LOG_LEVEL=INFO

# --- Backend API --------------------------------------------------------
BACKEND_DATABASE_URL=sqlite:///data/backend.sqlite
BACKEND_MAX_CONCURRENT_RUNS=4
# JSON list of allowed browser origins; ["*"] allows any (without credentials)
CORS_ORIGINS=["*"]
